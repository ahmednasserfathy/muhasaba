    "/api/v1/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Get Catalog",
        "description": "Public official catalog only; no user-specific state or editorial drafts.",
        "operationId": "get_catalog_api_v1_catalog_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Explicit local date (YYYY-MM-DD)",
              "title": "Date"
            },
            "description": "Explicit local date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          },
          "404": {
            "description": "No published release for this date"
          },
          "503": {
            "description": "Catalog database unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
